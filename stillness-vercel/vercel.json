{
  "cleanUrls": true,
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci",
  "functions": {
    "api/kokoro.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/kokoro-js/voices/af_heart.bin",
      "excludeFiles": "node_modules/{onnxruntime-node/bin/napi-v3/{darwin,win32,linux/arm64}/**,onnxruntime-web/dist/*.wasm,@huggingface/transformers/dist/*.wasm}"
    },
    "api/{account,billing,script,status,stripe-webhook,trial-email,tts}.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    { "path": "/api/trial-email", "schedule": "0 15 * * *" }
  ],
  "redirects": [
    {
      "source": "/welcome",
      "has": [{ "type": "host", "value": "stillness-members.vercel.app" }],
      "destination": "https://trystillness.vercel.app/welcome",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/welcome",
      "permanent": false,
      "missing": [
        { "type": "cookie", "key": "stillness_access" },
        { "type": "cookie", "key": "stillness_refresh" },
        { "type": "cookie", "key": "stillness_recovery_access" },
        { "type": "query", "key": "app" },
        { "type": "query", "key": "flow" },
        { "type": "query", "key": "code" },
        { "type": "query", "key": "error" },
        { "type": "query", "key": "error_code" },
        { "type": "query", "key": "billing" },
        { "type": "query", "key": "password" },
        { "type": "query", "key": "view" }
      ]
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
