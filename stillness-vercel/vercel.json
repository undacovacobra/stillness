{
  "cleanUrls": true,
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci",
  "functions": {
    "api/kokoro.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/kokoro-js/voices/af_heart.bin",
      "excludeFiles": "node_modules/{onnxruntime-node/bin/napi-v3/{darwin,win32,linux/arm64}/**,onnxruntime-web/dist/*.wasm,@huggingface/transformers/dist/*.wasm}"
    },
    "api/{account,billing,script,status,stripe-webhook,trial-email,tts}.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    { "path": "/api/trial-email", "schedule": "0 15 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
